# Settings for the dashboard Worker. In production these are Worker secrets:
# `npm run setup` (or the Deploy to Cloudflare button) prompts for each one.
# Locally, copy this file to .dev.vars. Never commit .dev.vars.

# Cloudflare account ID and a READ-ONLY API token scoped to that account.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Optional: Anthropic Admin key (sk-ant-admin01-...). Use "none" to skip.
ANTHROPIC_ADMIN_KEY=none

# Optional: OpenAI Admin key restricted to usage read. Use "none" to skip.
OPENAI_ADMIN_KEY=none

# Which config/<profile>.json maps resources to apps.
CONFIG_PROFILE=example
